Show("=== Testing BlazeLang Parity ===")

// 1. Arithmetic & Variables
var x = 10
var y = 20
var z = x * 2 + y / 2 - 5
Show("Arithmetic z: " + z)

// 2. Functions & Recursion
Function fib(n) {
    if n <= 1 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}
Show("fib(10): " + fib(10))

// 3. Closures
Function makeAdder(base) {
    return function(n) {
        return base + n
    }
}
var add100 = makeAdder(100)
Show("add100(42): " + add100(42))

// 4. Loops & Range & Control Flow
var sum = 0
for i in range(1, 11) {
    if i == 5 {
        Continue
    }
    if i == 9 {
        Break
    }
    sum += i
}
Show("Loop sum: " + sum)

// 5. Structs
Struct Person { name age }
var p = Person("Alice", 30)
Show("Person: " + p.name + ", age=" + p.age)

// 6. List Iteration
var items = [10, 20, 30]
var total = 0
for item in items {
    total += item
}
Show("List total: " + total)

Show("All Parity Tests Completed Successfully!")
