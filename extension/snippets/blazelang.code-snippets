{
  "if": { "prefix": "if", "body": ["if ${1:condition} {", "    ${0}", "}"], "description": "BlazeLang if statement" },
  "if else": { "prefix": "ifelse", "body": ["if ${1:condition} {", "    ${2}", "}", "else {", "    ${0}", "}"], "description": "BlazeLang if/else statement" },
  "while": { "prefix": "while", "body": ["while ${1:condition} {", "    ${0}", "}"], "description": "BlazeLang while loop" },
  "for": { "prefix": "for", "body": ["for ${1:item} in ${2:items} {", "    ${0}", "}"], "description": "BlazeLang for-in loop" },
  "foreach range": { "prefix": "foreach", "body": ["for ${1:index} in range(${2:0}, ${3:10}) {", "    ${0}", "}"], "description": "BlazeLang range loop" },
  "function": { "prefix": "func", "body": ["Function ${1:Name}(${2}) {", "    ${0}", "}"], "description": "BlazeLang function" },
  "class": { "prefix": "class", "body": ["Class ${1:Name} {", "    Constructor(${2}) {", "        ${0}", "    }", "}"], "description": "BlazeLang class" },
  "try catch": { "prefix": "trycatch", "body": ["try {", "    ${1}", "}", "catch (${2:error}) {", "    ${0}", "}"], "description": "BlazeLang try/catch" },
  "try catch finally": { "prefix": "tryfinally", "body": ["try {", "    ${1}", "}", "catch (${2:error}) {", "    ${3}", "}", "finally {", "    ${0}", "}"], "description": "BlazeLang try/catch/finally" },
  "Show": { "prefix": "show", "body": ["Show(${1:value})"], "description": "Print a value with a newline" },
  "Print": { "prefix": "print", "body": ["Print(${1:value})"], "description": "Print a value without a newline" },
  "Input": { "prefix": "input", "body": ["var ${1:value} = Input(\"${2:Prompt: }\")"], "description": "Read terminal input" }
}
