{
  "var": { "prefix": "var", "body": ["var ${1:name} = ${0:value}"], "description": "BlazeLang variable declaration" },
  "constant": { "prefix": ["const", "constant"], "body": ["constant ${1:NAME} = ${0:value}"], "description": "BlazeLang constant declaration" },
  "bind": { "prefix": "bind", "body": ["bind ${1:state} = ${0:value}"], "description": "BlazeLang reactive state variable" },
  "if": { "prefix": "if", "body": ["if ${1:condition} {", "    ${0}", "}"], "description": "BlazeLang if statement" },
  "if else": { "prefix": "ifelse", "body": ["if ${1:condition} {", "    ${2}", "}", "else {", "    ${0}", "}"], "description": "BlazeLang if/else statement" },
  "while": { "prefix": "while", "body": ["while ${1:condition} {", "    ${0}", "}"], "description": "BlazeLang while loop" },
  "for": { "prefix": "for", "body": ["for ${1:item} in ${2:items} {", "    ${0}", "}"], "description": "BlazeLang for-in loop" },
  "foreach range": { "prefix": ["foreach", "range"], "body": ["for ${1:i} in range(${2:0}, ${3:10}) {", "    ${0}", "}"], "description": "BlazeLang range loop" },
  "Function": { "prefix": ["Function", "func", "fn", "function"], "body": ["Function ${1:name}(${2:params}) {", "    ${0}", "}"], "description": "BlazeLang function declaration" },
  "Class": { "prefix": ["Class", "class"], "body": ["Class ${1:Name} {", "    Constructor(${2:params}) {", "        ${0}", "    }", "}"], "description": "BlazeLang class declaration" },
  "Struct": { "prefix": ["Struct", "struct"], "body": ["Struct ${1:Name} {", "    ${0:field = default}", "}"], "description": "BlazeLang struct record" },
  "Enum": { "prefix": ["Enum", "enum"], "body": ["Enum ${1:Name} {", "    ${0:Value}", "}"], "description": "BlazeLang enum constants" },
  "Constructor": { "prefix": ["Constructor", "ctor"], "body": ["Constructor(${1:params}) {", "    ${0}", "}"], "description": "BlazeLang class constructor" },
  "Meta": { "prefix": "meta", "body": ["Meta ${1:name}(${2:params}) {", "    ${0}", "}"], "description": "BlazeLang Meta routine" },
  "Import": { "prefix": ["Import", "import"], "body": ["Import ${1:Name} from \"${2:module}\""], "description": "BlazeLang module import" },
  "Export": { "prefix": ["Export", "export"], "body": ["Export ${1:Name}"], "description": "BlazeLang symbol export" },
  "try catch": { "prefix": ["try", "trycatch"], "body": ["try {", "    ${1}", "}", "catch ${2:err} {", "    ${0}", "}"], "description": "BlazeLang try/catch" },
  "try catch finally": { "prefix": "tryfinally", "body": ["try {", "    ${1}", "}", "catch ${2:err} {", "    ${3}", "}", "finally {", "    ${0}", "}"], "description": "BlazeLang try/catch/finally" },
  "throw": { "prefix": "throw", "body": ["throw \"${0:error}\""], "description": "BlazeLang raise exception" },
  "return": { "prefix": "return", "body": ["return ${0}"], "description": "BlazeLang return statement" },
  "Show": { "prefix": "show", "body": ["Show(${1:value})"], "description": "Print values with a newline" },
  "Print": { "prefix": "print", "body": ["Print(${1:value})"], "description": "Print values without a newline" },
  "Input": { "prefix": "input", "body": ["var ${1:name} = Input(\"${2:Enter: }\")"], "description": "Read line from terminal" },
  "HttpServer": { "prefix": "httpserver", "body": ["var server = HttpServer.Create(${1:8080})", "", "server.Get(\"${2:/}\", Function(req, res) {", "    ${0:res.Send(\"Hello from BlazeLang Server!\")}", "})", "", "server.Listen()"], "description": "BlazeLang HTTP Web Server" },
  "File Read": { "prefix": "fileread", "body": ["var ${1:text} = File.Read(\"${2:file.txt}\")"], "description": "Read file into string" },
  "File Write": { "prefix": "filewrite", "body": ["File.Write(\"${1:file.txt}\", ${2:content})"], "description": "Write string to file" },
  "Json Parse": { "prefix": "jsonparse", "body": ["var ${1:data} = Json.Parse(${2:jsonString})"], "description": "Parse JSON string" },
  "Json Stringify": { "prefix": "jsonstringify", "body": ["var ${1:json} = Json.Stringify(${2:data})"], "description": "Stringify object to JSON" }
}
