        hasDecimal = false
    } else {
        if current == "0" {
            current = "8"
        } else {
            current = current + "8"
        }
    }

    Refresh()
}


Function Digit9() {
    if waiting {
        current = "9"
        waiting = false
        hasDecimal = false
    } else {
        if current == "0" {
            current = "9"
        } else {
            current = current + "9"
        }
    }

    Refresh()
}


Function Decimal() {
    if waiting {
        current = "0."
        waiting = false
        hasDecimal = true
        Refresh()
        return
    }

    if hasDecimal == false {
        current = current + "."
        hasDecimal = true
    }

    Refresh()
}


Function Add() {
    first = Float(current)
    operation = "+"
    waiting = true
    hasDecimal = false
    status.SetText(String(first) + " +")
}


Function Subtract() {
    first = Float(current)
    operation = "-"
    waiting = true
    hasDecimal = false
    status.SetText(String(first) + " -")
}


Function Multiply() {
    first = Float(current)
    operation = "*"
    waiting = true
    hasDecimal = false
    status.SetText(String(first) + " ×")
}


Function Divide() {
    first = Float(current)
    operation = "/"
    waiting = true
    hasDecimal = false
    status.SetText(String(first) + " ÷")
}


Function Percent() {
    var value = Float(current)
    value = value / 100
    current = String(value)
    waiting = true
    Refresh()
}


Function Sign() {
    var value = Float(current)
    value = value * -1
    current = String(value)
    Refresh()
}


Function Equals() {
    var second = Float(current)
    var result = 0

    if operation == "+" {
        result = first + second
    }

    if operation == "-" {
        result = first - second
    }

    if operation == "*" {
        result = first * second
    }

    if operation == "/" {
        if second == 0 {
            current = "Error"
            status.SetText("Cannot divide by zero")
            waiting = true
            operation = ""
            Refresh()
            return
        }

        result = first / second
    }

    current = String(result)

    status.SetText(
        String(first) + " " +
        operation + " " +
        String(second) + " ="
    )

    operation = ""
    waiting = true
    hasDecimal = false

    Refresh()
}


Function Backspace() {
    if waiting {
        return
    }

    if current == "0" {
        return
    }

    var result = ""
    var i = 0
    var length = len(current)

    while i < length - 1 {
        result = result + current[i]
        i = i + 1
    }

    if result == "" {
        current = "0"
    } else {
        current = result
    }

    Refresh()
}


Function MakeButton(text, callback, background, foreground) {
    var button = GUI.Button(text)

    button.SetStyle({
        background: background,
        foreground: foreground,
        font: 20
    })

    button.OnClick(callback)

    return button
}


app.Add(title)
app.Add(display)
app.Add(status)


var row1 = GUI.Row()

var clear = MakeButton(
    "C",
    Clear,
    "#dc2626",
    "#ffffff"
)

var percent = MakeButton(
    "%",
    Percent,
    "#374151",
    "#ffffff"
)

var sign = MakeButton(
    "+/-",
    Sign,
    "#374151",
    "#ffffff"
)

var divide = MakeButton(
    "÷",
    Divide,
    "#2563eb",
    "#ffffff"
)

row1.Add(clear)
row1.Add(percent)
row1.Add(sign)
row1.Add(divide)

app.Add(row1)


