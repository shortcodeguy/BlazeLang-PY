Import GUI from "gui"

var app = GUI.Create("BlazeLang Calculator", 420, 620)

var display = GUI.Input("0")
display.SetStyle({
    background: "#111827",
    foreground: "#ffffff",
    font: 28
})

var title = GUI.Label("BLAZELANG CALCULATOR")
title.SetStyle({
    foreground: "#60a5fa",
    font: 18
})

var status = GUI.Label("Ready")
status.SetStyle({
    foreground: "#9ca3af",
    font: 12
})

var current = "0"
var first = 0
var operation = ""
var waiting = false
var hasDecimal = false


Function Refresh() {
    display.SetValue(current)
}


Function Clear() {
    current = "0"
    first = 0
    operation = ""
    waiting = false
    hasDecimal = false
    status.SetText("Ready")
    Refresh()
}


Function Digit0() {
    if waiting {
        current = "0"
        waiting = false
        hasDecimal = false
    }

    if current != "0" {
        current = current + "0"
    }

    Refresh()
}


Function Digit1() {
    if waiting {
        current = "1"
        waiting = false
        hasDecimal = false
    } else {
        if current == "0" {
            current = "1"
        } else {
            current = current + "1"
        }
    }

    Refresh()
}


Function Digit2() {
    if waiting {
        current = "2"
        waiting = false
        hasDecimal = false
    } else {
        if current == "0" {
            current = "2"
        } else {
            current = current + "2"
        }
    }

    Refresh()
}


Function Digit3() {
    if waiting {
        current = "3"
        waiting = false
        hasDecimal = false
    } else {
        if current == "0" {
            current = "3"
        } else {
            current = current + "3"
        }
    }

    Refresh()
}


Function Digit4() {
    if waiting {
        current = "4"
        waiting = false
        hasDecimal = false
    } else {
        if current == "0" {
            current = "4"
        } else {
            current = current + "4"
        }
    }

    Refresh()
}


Function Digit5() {
    if waiting {
        current = "5"
