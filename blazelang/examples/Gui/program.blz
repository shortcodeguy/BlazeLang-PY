        }
    }

    Refresh()
}


Function Digit6() {
    if waiting {
        current = "6"
        waiting = false
        hasDecimal = false
    } else {
        if current == "0" {
            current = "6"
        } else {
            current = current + "6"
        }
    }

    Refresh()
}


Function Digit7() {
    if waiting {
        current = "7"
