Import Json from "json"

Struct User {
    name
    active = true
}

Struct Address {
    city
    pin
}

Struct Profile {
    user
    address
    tags
    value = null
}

var profile = Profile(
User("Asha"),
Address("Patna", 800001),
["BlazeLang"]
)

profile.user.name = "Mira"
profile.tags[0] = "Structs"

Show(profile.user.name)
Show(profile.address.city)
Show(profile.value == null)
Show(Json.Stringify(profile))
