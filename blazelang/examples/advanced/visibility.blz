Class Account {
private var balance = 0

Constructor(owner) {
    this.owner = owner
}

public Function Deposit(amount) {
    this.balance += amount
    return this.balance
}

private Function InternalMessage() {
    return "account is valid"
}

public Function Status() {
    return this.owner + ": " + this.InternalMessage()
}

}

var account = Account("Asha")

Show(account.Deposit(50))
Show(account.Status())

// account.InternalMessage() is intentionally private.
