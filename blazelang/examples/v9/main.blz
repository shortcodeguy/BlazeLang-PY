// BlazeLang HTTP Server Example

Import HttpServer from "httpserver"

Meta handleRequest(req) {

    Show("========== REQUEST ==========")
    Show("Method: " + req.method)
    Show("Path: " + req.path)

    return {
        status: 200,

        headers: {
            ContentType: "application/json"
        },

        body: {
            success: true,
            message: "Everything working fine!",
            server: "BlazeLang HTTP Server",
            status: "Online",
            method: req.method,
            path: req.path,
            query: req.query,
            headers: req.headers
        }
    }
}

Show("Starting BlazeLang HTTP Server...")

HttpServer.listen(8080, handleRequest)