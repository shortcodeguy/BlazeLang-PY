// =====================================================================
// error_check.blz
// One try/catch block per RUNTIME error type (BLZ2xxx).
// Each block prints a label + the caught message, so you can check
// every line against the // comment above it.
//
// NOTE: Lexer errors (BLZ1001) and Parser errors (BLZ1002) CANNOT go in
// this file — they crash before the program ever runs. Those are in
// error_check_lexer.blz and error_check_parser.blz (separate files,
// one error each, since the whole file fails to parse).
// =====================================================================

Class Animal {
    private secret

    Constructor() {
        this.secret = "shh"
    }

    private Function Hidden() {
        return "you can't see me"
    }

    Function Speak() {
        return "..."
    }
}

Function NeedsTwo(a, b) {
    return a + b
}

// ---------------------------------------------------------------
// BLZ2002 - NameError: undefined variable/function
// ---------------------------------------------------------------
try {
    Show(totallyUndefinedVariable)
} catch (e) {
    Show("[BLZ2002 NameError] ", e)
}

// ---------------------------------------------------------------
// BLZ2003 - ZeroDivisionError: division by zero
// ---------------------------------------------------------------
try {
    var x = 10 / 0
} catch (e) {
    Show("[BLZ2003 ZeroDivisionError /] ", e)
}

try {
    var y = 10 % 0
} catch (e) {
    Show("[BLZ2003 ZeroDivisionError %] ", e)
}

// ---------------------------------------------------------------
// BLZ2004 - TypeError: incompatible operand types
// ---------------------------------------------------------------
try {
    var z = [1, 2] - [3, 4]
} catch (e) {
    Show("[BLZ2004 TypeError] ", e)
}

// ---------------------------------------------------------------
// BLZ2005 - IndexError: list index out of bounds
// NOTE: current interpreter raises a raw Python IndexError here, not
// BLZ2005, because visit_ArrayAccess does not catch it. It will still
// be caught by try/catch's generic Exception handler.
// ---------------------------------------------------------------
try {
    var arr = [1, 2, 3]
    Show(arr[10])
} catch (e) {
    Show("[BLZ2005 IndexError] ", e)
}

// ---------------------------------------------------------------
// BLZ2006 - KeyError: missing key in map
// NOTE: current interpreter's visit_PropertyAccess/ArrayAccess on a
// dict uses .get() and returns null instead of raising KeyError, so
// this block will NOT actually throw. Included for completeness.
// ---------------------------------------------------------------
try {
    var obj = { name: "Blaze" }
    Show(obj["missingKey"])
} catch (e) {
    Show("[BLZ2006 KeyError - not actually raised, returns null] ", obj["missingKey"])
}

// ---------------------------------------------------------------
// BLZ2007 - ArgumentError: wrong number of arguments
// NOTE: current interpreter does NOT validate argument count
// (missing args are just bound to null), so this will NOT throw.
// Included for completeness / to prove the gap.
// ---------------------------------------------------------------
try {
    Show(NeedsTwo(1))
} catch (e) {
    Show("[BLZ2007 ArgumentError - not actually raised] ", e)
}

// ---------------------------------------------------------------
// BLZ2008 - AccessError: private member accessed from outside class
// ---------------------------------------------------------------
try {
    var a = Animal()
    Show(a.Hidden())
} catch (e) {
    Show("[BLZ2008 AccessError] ", e)
}

// ---------------------------------------------------------------
// BLZ2009 - ImmutableError: assigning to a constant
// ---------------------------------------------------------------
try {
    constant PI = 3
    PI = 4
} catch (e) {
    Show("[BLZ2009 ImmutableError] ", e)
}

// ---------------------------------------------------------------
// BLZ2010 - NotCallableError: calling a non-callable value
// ---------------------------------------------------------------
try {
    var notAFunction = 42
    notAFunction()
} catch (e) {
    Show("[BLZ2010 NotCallableError] ", e)
}

// ---------------------------------------------------------------
// BLZ2011 - PropertyError: accessing a nonexistent/invalid property
// ---------------------------------------------------------------
try {
    var n = 5
    Show(n.doesNotExist)
} catch (e) {
    Show("[BLZ2011 PropertyError] ", e)
}

// ---------------------------------------------------------------
// BLZ2012 - RecursionError: max call stack exceeded
// NOTE: this raises Python's native RecursionError, not BLZ2012,
// because nothing in Function.__call__ checks depth. It will still
// be caught here by the generic except Exception.
// ---------------------------------------------------------------
Function Boom() {
    return Boom()
}
try {
    Boom()
} catch (e) {
    Show("[BLZ2012 RecursionError] caught (message may be a raw Python error)")
}

// ---------------------------------------------------------------
// BLZ2013 - LoopControlError: break/continue outside a loop
// NOTE: 'break' used at statement level parses fine, but nothing in
// visit_BreakStatement/visit_ContinueStatement checks "am I in a
// loop" - the interpreter only raises this from visit_Program's
// top-level catch of BreakException/ContinueException. So this only
// triggers if break/continue escapes ALL the way to top level.
// ---------------------------------------------------------------
// (Left undemonstrated inside try/catch on purpose - see notes above:
//  a bare top-level `Break` outside any function/loop would need to be
//  its own top-level statement, not nested in try/catch, since
//  BreakException isn't a BlazeError and gets treated as a generic
//  Exception by the try/catch handler instead of propagating to
//  visit_Program.)

// ---------------------------------------------------------------
// BLZ2014 - ReturnOutsideFunctionError: return outside a function
// NOTE: nothing in visit_ReturnStatement checks this; a top-level
// 'return' just raises ReturnException, which is not a BlazeError.
// This is not currently reachable/thrown by the interpreter.
// ---------------------------------------------------------------

// ---------------------------------------------------------------
// BLZ2015 - InstantiationError: instantiating a non-class
// NOTE: not currently thrown - FunctionCall only checks isinstance
// Class for instantiate(); calling a non-class with parens instead
// raises NotCallableError (BLZ2010) or works fine if it IS callable.
// There's no code path that constructs InstantiationError today.
// ---------------------------------------------------------------

// ---------------------------------------------------------------
// BLZ2016 - DuplicateDeclarationError
// NOTE: not currently thrown anywhere in the interpreter - redeclaring
// a var/function/class just overwrites the previous scope entry
// silently. No code path raises this today.
// ---------------------------------------------------------------
var dup = 1

Show("[BLZ2016 DuplicateDeclarationError - not actually raised] dup = ", dup)

// ---------------------------------------------------------------
// BLZ2017 - AssertionFailedError
// NOTE: there is no built-in Assert() function registered in
// _register_builtins, so this cannot be triggered by any BlazeLang
// program right now, even though the error class exists.
// ---------------------------------------------------------------

// ---------------------------------------------------------------
// BLZ2018 - NullReferenceError
// NOTE: not currently thrown - accessing/using null values (e.g.
// null + 1) instead raises a Python TypeError -> BLZ2004 TypeError,
// or in some paths just silently returns null. No code path raises
// NullReferenceError today.
// ---------------------------------------------------------------
try {
    var maybeNull = null
    var result = maybeNull + 1
} catch (e) {
    Show("[BLZ2018 NullReferenceError - actually raises BLZ2004 TypeError] ", e)
}

// ---------------------------------------------------------------
// BLZ2019 - StaticContextError: 'this'/'super' outside instance context
// ---------------------------------------------------------------
try {
    Show(this)
} catch (e) {
    Show("[BLZ2019 StaticContextError (this)] ", e)
}

try {
    Show(super)
} catch (e) {
    Show("[BLZ2019 StaticContextError (super)] ", e)
}

// ---------------------------------------------------------------
// BLZ3001 - ImportError: generic import failure
// BLZ3002 - ModuleError
// NOTE: ModuleError is never constructed/raised anywhere in the
// interpreter; only ImportError (BLZ3001) and CircularImportError
// (BLZ3003) are actually used.
// ---------------------------------------------------------------
try {
    Import something from "this_module_does_not_exist"
} catch (e) {
    Show("[BLZ3001 ImportError] ", e)
}

Show("=== done: all catchable runtime errors exercised above ===")
