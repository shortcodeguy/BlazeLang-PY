Show("=== Null + Variable Visibility Test ===")

// Normal null variable
var normalValue = null

if (normalValue == null) {
    Show("normalValue is null")
}


// Public null variable
public var publicValue = null

if (publicValue == null) {
    Show("publicValue is null")
}

Show(publicValue)


// Private null variable inside class
Class User {
    public var name = "Rohit"
    private var secret = null

    Function IsSecretNull() {
        return this.secret == null
    }

    Function SetSecret(value) {
        this.secret = value
    }

    Function GetSecret() {
        return this.secret
    }
}

var user = User()


// Private null accessed internally
if (user.IsSecretNull()) {
    Show("Private secret is null")
}


// Set private null variable
user.SetSecret("BlazeLang")

Show(user.GetSecret())


// Set it back to null
user.SetSecret(null)

if (user.IsSecretNull()) {
    Show("Private secret is null again")
}


// Direct access should fail
// Show(user.secret)

Show("TEST PASSED")