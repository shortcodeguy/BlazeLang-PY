Import Calculator from "test_module/math"

Show("================================")
Show("       BlazeLang Calculator")
Show("================================")

Calculator.Info()

var calculator = Calculator.Create()

Show("")
Show("Enter operation:")
Show("+  -  *  /  %  **")

var operation = Input()

Show("Enter first number:")
var first = Float(Input())

Show("Enter second number:")
var second = Float(Input())

var result = calculator.Calculate(
    operation,
    first,
    second
)

Show("")
Show("Result: " + result)
