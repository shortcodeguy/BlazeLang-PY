Import Json from "json"

Show("=== Struct Test ===")

Struct User {
name
age
email
}

var user = User("Rohit", 13, "[rohit@example.com](mailto:rohit@example.com)")

Show(user.name)
Show(user.age)
Show(user.email)

user.name = "Blaze"
user.age = 14

Show(user.name)
Show(user.age)

Struct Settings {
theme = "dark"
notifications = true
language = "English"
description = null
}

var settings = Settings()

Show(settings.theme)
Show(settings.notifications)
Show(settings.language)
Show(settings.description)

if settings.description == null {
Show("Description is null")
}

Struct Point {
x
y
}

var point = Point(10, 20)

Show(point.x)
Show(point.y)

var namedPoint = Point(
x: 100,
y: 200
)

Show(namedPoint.x)
Show(namedPoint.y)

Struct Account {
username
age
email = "[unknown@example.com](mailto:unknown@example.com)"
}

var account = Account(
"Rohit",
age: 14
)

Show(account.username)
Show(account.age)
Show(account.email)

Struct Profile {
name
bio = null
}

var profile = Profile()

if profile.name == null {
Show("Name is null")
}

if profile.bio == null {
Show("Bio is null")
}

profile.name = "Rohit"
profile.bio = "BlazeLang Developer"

Show(profile.name)
Show(profile.bio)

Struct Counter {
value = 0
}

var counter = Counter()

counter.value += 10
counter.value -= 2
counter.value *= 2
counter.value /= 4

Show(counter.value)

var counterA = Counter()
var counterB = Counter()

counterA.value = 100

Show(counterA.value)
Show(counterB.value)

Show(type(user))
Show(type(point))
Show(type(settings))

Struct Developer {
name
skills = ["BlazeLang"]
}

var developer = Developer(
name: "Rohit"
)

Show(developer.name)
Show(developer.skills)

Struct Project {
name
metadata
}

var project = Project(
"BlazeLang",
{
version: 1.7,
language: "BlazeLang"
}
)

Show(project.name)
Show(project.metadata)

Struct Server {
host
port = 8080
running = false
}

var server = Server("localhost")

if server.running == false {
Show("Server is stopped")
}

server.running = true

if server.running {
Show("Server is running")
}

var users = [
User("Rohit", 14, "[rohit@example.com](mailto:rohit@example.com)"),
User("Blaze", 1, "[blaze@example.com](mailto:blaze@example.com)")
]

for currentUser in users {
Show(currentUser.name)
}

var userJson = Json.Stringify(user)

Show(userJson)
