Import GUI from "gui"
Import Http from "http"
Import Json from "json"


var API_KEY = "Openrouter_api_key"


var app = GUI.Create(
    "BlazeLang AI",
    700,
    650
)


var title = GUI.Label(
    "BLAZELANG AI"
)

title.SetStyle({
    foreground: "#60a5fa",
    font: 26
})


var subtitle = GUI.Label(
    "AI Assistant powered by BlazeLang"
)

subtitle.SetStyle({
    foreground: "#9ca3af",
    font: 13
})


var output = GUI.TextArea("")

output.SetStyle({
    background: "#111827",
    foreground: "#ffffff",
    font: 14
})


var input = GUI.Input("")

input.SetStyle({
    background: "#1f2937",
    foreground: "#ffffff",
    font: 16
})


var status = GUI.Label(
    "Ready"
)

status.SetStyle({
    foreground: "#9ca3af",
    font: 12
})


Function AskAI() {

    var question = input.GetValue()

    if question == "" {
        status.SetText("Enter a message")
        return
    }


    status.SetText("Thinking...")


    var request = {
        model: "google/gemma-3-27b-it",

        messages: [
            {
                role: "system",
                content: "You are BlazeLang AI, a helpful AI assistant."
            },

            {
                role: "user",
                content: question
            }
        ]
    }


    var body = Json.Stringify(
        request
    )


    var response = Http.Post(
        "https://openrouter.ai/api/v1/chat/completions",
        body,
        {
            apiKey: API_KEY,
            contentType: "application/json",
            accept: "application/json",
            timeout: 30000
        }
    )


    if response.status != 200 {

        status.SetText(
            "Request failed: " +
            String(response.status)
        )

        output.SetValue(
            String(response.body)
        )

        return
    }


    /*
        Http module already parses JSON responses.

        Do NOT use:

        Json.Parse(String(response.body))
    */


    var data = response.body


    var answer =
        data.choices[0].message.content


    output.SetValue(
        String(answer)
    )


    input.SetValue("")

    status.SetText("Ready")
}


Function ClearChat() {

    output.SetValue("")
    input.SetValue("")
    status.SetText("Ready")
}


var ask = GUI.Button(
    "Ask AI"
)

ask.SetStyle({
    background: "#2563eb",
    foreground: "#ffffff",
    font: 17
})

ask.OnClick(
    AskAI
)


var clear = GUI.Button(
    "Clear"
)

clear.SetStyle({
    background: "#dc2626",
    foreground: "#ffffff",
    font: 17
})

clear.OnClick(
    ClearChat
)


app.Add(title)
app.Add(subtitle)
app.Add(output)
app.Add(input)
app.Add(ask)
app.Add(clear)
app.Add(status)


app.Run()