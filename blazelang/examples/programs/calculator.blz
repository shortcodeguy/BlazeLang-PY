// ============================================================
// BlazeLang Math App Suite
// Class + Meta + Functions + Math + Convert Module
// ============================================================

Import Math from "math"
Import Convert from "convert"


// ============================================================
// CALCULATOR CLASS
// ============================================================

Class Calculator {

    // ========================================================
    // CREATE
    // ========================================================

    Meta Create(name) {
        Show("")
        Show("================================")
        Show("      " + name)
        Show("================================")
    }


    // ========================================================
    // MAIN MENU
    // ========================================================

    Meta Menu() {

        Show("")
        Show("========== CALCULATOR ==========")
        Show("1. Basic Calculator")
        Show("2. Scientific Calculator")
        Show("3. Geometry Calculator")
        Show("4. Statistics Calculator")
        Show("5. Number Theory")
        Show("6. Vector Calculator")
        Show("7. Matrix Calculator")
        Show("8. Game Damage Calculator")
        Show("9. Physics Calculator")
        Show("10. Random Dice")
        Show("11. Exit")
        Show("")
    }


    // ========================================================
    // BASIC CALCULATOR
    // ========================================================

    Meta Basic() {

        var running = true

        while running {

            Show("")
            Show("========== BASIC CALCULATOR ==========")
            Show("1. Calculate")
            Show("0. Back")
            Show("")

            var choice = Convert.ToInt32(
                Input("Choose operation: ")
            )

            if choice == 0 {

                running = false

            }

            else if choice == 1 {

                var a = Convert.ToFloat(
                    Input("Enter first number: ")
                )

                var op = Input(
                    "Enter operation (+ - * / % ^): "
                )

                var b = Convert.ToFloat(
                    Input("Enter second number: ")
                )

                if op == "+" {
                    Show("Result: " + (a + b))
                }

                else if op == "-" {
                    Show("Result: " + (a - b))
                }

                else if op == "*" {
                    Show("Result: " + (a * b))
                }

                else if op == "/" {
                    Show("Result: " + (a / b))
                }

                else if op == "%" {
                    Show("Result: " + Math.Mod(a, b))
                }

                else if op == "^" {
                    Show("Result: " + Math.Pow(a, b))
                }

                else {
                    Show("Invalid operator.")
                }
            }

            else {
                Show("Invalid choice. Please choose 1 or 0.")
            }
        }
    }


    // ========================================================
    // SCIENTIFIC CALCULATOR
    // ========================================================

    Meta Scientific() {

        var running = true

        while running {

            Show("")
            Show("========== SCIENTIFIC CALCULATOR ==========")
            Show("1. Square Root")
            Show("2. Power")
            Show("3. Sin")
            Show("4. Cos")
            Show("5. Tan")
            Show("6. Log10")
            Show("7. Natural Log")
            Show("8. Factorial")
            Show("0. Back")
            Show("")

            var choice = Convert.ToInt32(
                Input("Choose operation: ")
            )

            if choice == 0 {

                running = false
            }

            else if choice == 1 {

                var n = Convert.ToFloat(
                    Input("Enter number: ")
                )

                Show("Result:")
                Show(Math.Sqrt(n))
            }

            else if choice == 2 {

                var n = Convert.ToFloat(
                    Input("Enter base: ")
                )

                var p = Convert.ToFloat(
                    Input("Enter power: ")
                )

                Show("Result:")
                Show(Math.Pow(n, p))
            }

            else if choice == 3 {

                var angle = Convert.ToFloat(
                    Input("Enter angle in degrees: ")
                )

                Show("Result:")
                Show(Math.SinDeg(angle))
            }

            else if choice == 4 {

                var angle = Convert.ToFloat(
                    Input("Enter angle in degrees: ")
                )

                Show("Result:")
                Show(Math.CosDeg(angle))
            }

            else if choice == 5 {

                var angle = Convert.ToFloat(
                    Input("Enter angle in degrees: ")
                )

                Show("Result:")
                Show(Math.TanDeg(angle))
            }

            else if choice == 6 {

                var n = Convert.ToFloat(
                    Input("Enter number: ")
                )

                Show("Result:")
                Show(Math.Log10(n))
            }

            else if choice == 7 {

                var n = Convert.ToFloat(
                    Input("Enter number: ")
                )

                Show("Result:")
                Show(Math.Log(n))
            }

            else if choice == 8 {

                var n = Convert.ToInt64(
                    Input("Enter number: ")
                )

                Show("Result:")
                Show(Math.Factorial(n))
            }

            else {

                Show(
                    "Invalid choice. Please choose 1-8 or 0 to go back."
                )
            }
        }
    }


    // ========================================================
    // GEOMETRY CALCULATOR
    // ========================================================

    Meta Geometry() {

        var running = true

        while running {

            Show("")
            Show("========== GEOMETRY CALCULATOR ==========")
            Show("1. Circle Area")
            Show("2. Circle Circumference")
            Show("3. Rectangle Area")
            Show("4. Triangle Area")
            Show("5. 2D Distance")
            Show("6. 3D Distance")
            Show("0. Back")
            Show("")

            var choice = Convert.ToInt32(
                Input("Choose operation: ")
            )

            if choice == 0 {

                running = false
            }

            else if choice == 1 {

                var r = Convert.ToFloat(
                    Input("Enter radius: ")
                )

                Show("Area:")
                Show(Math.CircleArea(r))
            }

            else if choice == 2 {

                var r = Convert.ToFloat(
                    Input("Enter radius: ")
                )

                Show("Circumference:")
                Show(Math.CircleCircumference(r))
            }

            else if choice == 3 {

                var w = Convert.ToFloat(
                    Input("Enter width: ")
                )

                var h = Convert.ToFloat(
                    Input("Enter height: ")
                )

                Show("Area:")
                Show(Math.RectangleArea(w, h))
            }

            else if choice == 4 {

                var b = Convert.ToFloat(
                    Input("Enter base: ")
                )

                var h = Convert.ToFloat(
                    Input("Enter height: ")
                )

                Show("Area:")
                Show(Math.TriangleArea(b, h))
            }

            else if choice == 5 {

                var x1 = Convert.ToFloat(
                    Input("X1: ")
                )

                var y1 = Convert.ToFloat(
                    Input("Y1: ")
                )

                var x2 = Convert.ToFloat(
                    Input("X2: ")
                )

                var y2 = Convert.ToFloat(
                    Input("Y2: ")
                )

                Show("Distance:")
                Show(Math.Distance2D(
                    x1,
                    y1,
                    x2,
                    y2
                ))
            }

            else if choice == 6 {

                var x1 = Convert.ToFloat(
                    Input("X1: ")
                )

                var y1 = Convert.ToFloat(
                    Input("Y1: ")
                )

                var z1 = Convert.ToFloat(
                    Input("Z1: ")
                )

                var x2 = Convert.ToFloat(
                    Input("X2: ")
                )

                var y2 = Convert.ToFloat(
                    Input("Y2: ")
                )

                var z2 = Convert.ToFloat(
                    Input("Z2: ")
                )

                Show("Distance:")

                Show(Math.Distance3D(
                    x1,
                    y1,
                    z1,
                    x2,
                    y2,
                    z2
                ))
            }

            else {

                Show(
                    "Invalid choice. Please choose 1-6 or 0 to go back."
                )
            }
        }
    }


    // ========================================================
    // STATISTICS
    // ========================================================

    Meta Statistics() {

        var running = true

        while running {

            Show("")
            Show("========== STATISTICS ==========")
            Show("1. Calculate Statistics")
            Show("0. Back")
            Show("")

            var choice = Convert.ToInt32(
                Input("Choose operation: ")
            )

            if choice == 0 {

                running = false
            }

            else if choice == 1 {

                var a = Convert.ToFloat(
                    Input("Number 1: ")
                )

                var b = Convert.ToFloat(
                    Input("Number 2: ")
                )

                var c = Convert.ToFloat(
                    Input("Number 3: ")
                )

                var d = Convert.ToFloat(
                    Input("Number 4: ")
                )

                var e = Convert.ToFloat(
                    Input("Number 5: ")
                )

                Show("Sum:")
                Show(Math.Sum(a, b, c, d, e))

                Show("Mean:")
                Show(Math.Mean(a, b, c, d, e))

                Show("Median:")
                Show(Math.Median(a, b, c, d, e))

                Show("Variance:")
                Show(Math.Variance(a, b, c, d, e))

                Show("Standard Deviation:")
                Show(Math.StdDev(a, b, c, d, e))

                Show("Range:")
                Show(Math.Range(a, b, c, d, e))
            }

            else {

                Show(
                    "Invalid choice. Please choose 1 or 0."
                )
            }
        }
    }


    // ========================================================
    // NUMBER THEORY
    // ========================================================

    Meta NumberTheory() {

        var running = true

        while running {

            Show("")
            Show("========== NUMBER THEORY ==========")
            Show("1. Analyze Number")
            Show("0. Back")
            Show("")

            var choice = Convert.ToInt32(
                Input("Choose operation: ")
            )

            if choice == 0 {

                running = false
            }

            else if choice == 1 {

                var n = Convert.ToInt64(
                    Input("Enter number: ")
                )

                Show("Is Prime:")
                Show(Math.IsPrimeFast(n))

                Show("Factors:")
                Show(Math.Factors(n))

                Show("Next Prime:")
                Show(Math.NextPrime(n))

                Show("Is Even:")
                Show(Math.IsEven(n))

                Show("Is Odd:")
                Show(Math.IsOdd(n))

                Show("Factorial:")
                Show(Math.Factorial(n))

                Show("Fibonacci:")
                Show(Math.FastFibonacci(n))
            }

            else {

                Show(
                    "Invalid choice. Please choose 1 or 0."
                )
            }
        }
    }


    // ========================================================
    // VECTOR CALCULATOR
    // ========================================================

    Meta Vector() {

        var running = true

        while running {

            Show("")
            Show("========== VECTOR CALCULATOR ==========")
            Show("1. Calculate Vectors")
            Show("0. Back")
            Show("")

            var choice = Convert.ToInt32(
                Input("Choose operation: ")
            )

            if choice == 0 {

                running = false
            }

            else if choice == 1 {

                var x1 = Convert.ToFloat(
                    Input("Vector 1 X: ")
                )

                var y1 = Convert.ToFloat(
                    Input("Vector 1 Y: ")
                )

                var x2 = Convert.ToFloat(
                    Input("Vector 2 X: ")
                )

                var y2 = Convert.ToFloat(
                    Input("Vector 2 Y: ")
                )

                var v1 = [x1, y1]
                var v2 = [x2, y2]

                Show("Vector Addition:")
                Show(Math.VectorAdd(v1, v2))

                Show("Vector Subtraction:")
                Show(Math.VectorSubtract(v1, v2))

                Show("Vector 1 Length:")
                Show(Math.VectorLength(v1))

                Show("Vector 2 Length:")
                Show(Math.VectorLength(v2))

                Show("Distance:")
                Show(Math.VectorDistance(v1, v2))

                Show("Dot Product:")
                Show(Math.Dot(v1, v2))
            }

            else {

                Show(
                    "Invalid choice. Please choose 1 or 0."
                )
            }
        }
    }


    // ========================================================
    // MATRIX CALCULATOR
    // ========================================================

    Meta Matrix() {

        var running = true

        while running {

            Show("")
            Show("========== MATRIX CALCULATOR ==========")
            Show("1. Calculate Matrix")
            Show("0. Back")
            Show("")

            var choice = Convert.ToInt32(
                Input("Choose operation: ")
            )

            if choice == 0 {

                running = false
            }

            else if choice == 1 {

                var a = [
                    [1, 2],
                    [3, 4]
                ]

                var b = [
                    [5, 6],
                    [7, 8]
                ]

                Show("Matrix A:")
                Show(a)

                Show("Matrix B:")
                Show(b)

                Show("A + B:")
                Show(Math.MatrixAdd(a, b))

                Show("A - B:")
                Show(Math.MatrixSubtract(a, b))

                Show("A * B:")
                Show(Math.MatrixMultiply(a, b))

                Show("Transpose:")
                Show(Math.MatrixTranspose(a))

                Show("Determinant:")
                Show(Math.MatrixDeterminant(a))

                Show("Trace:")
                Show(Math.MatrixTrace(a))
            }

            else {

                Show(
                    "Invalid choice. Please choose 1 or 0."
                )
            }
        }
    }


    // ========================================================
    // GAME DAMAGE CALCULATOR
    // ========================================================

    Meta Damage() {

        var running = true

        while running {

            Show("")
            Show("========== GAME DAMAGE CALCULATOR ==========")
            Show("1. Calculate Damage")
            Show("0. Back")
            Show("")

            var choice = Convert.ToInt32(
                Input("Choose operation: ")
            )

            if choice == 0 {

                running = false
            }

            else if choice == 1 {

                var damage = Convert.ToFloat(
                    Input("Base damage: ")
                )

                var multiplier = Convert.ToFloat(
                    Input("Multiplier: ")
                )

                var critical = Convert.ToInt32(
                    Input("Critical hit? 1/0: ")
                )

                var finalDamage = damage * multiplier

                if critical == 1 {
                    finalDamage = finalDamage * 2
                }

                finalDamage = Math.Clamp(
                    finalDamage,
                    0,
                    999999
                )

                Show("Final Damage:")
                Show(finalDamage)
            }

            else {

                Show(
                    "Invalid choice. Please choose 1 or 0."
                )
            }
        }
    }


    // ========================================================
    // PHYSICS CALCULATOR
    // ========================================================

    Meta Physics() {

        var running = true

        while running {

            Show("")
            Show("========== PHYSICS CALCULATOR ==========")
            Show("1. Distance Calculator")
            Show("0. Back")
            Show("")

            var choice = Convert.ToInt32(
                Input("Choose operation: ")
            )

            if choice == 0 {

                running = false
            }

            else if choice == 1 {

                var velocity = Convert.ToFloat(
                    Input("Velocity: ")
                )

                var time = Convert.ToFloat(
                    Input("Time: ")
                )

                var acceleration = Convert.ToFloat(
                    Input("Acceleration: ")
                )

                var distance =
                    velocity * time +
                    0.5 * acceleration * Math.Pow(time, 2)

                Show("Distance:")
                Show(distance)
            }

            else {

                Show(
                    "Invalid choice. Please choose 1 or 0."
                )
            }
        }
    }


    // ========================================================
    // DICE
    // ========================================================

    Meta Dice() {

        var running = true

        while running {

            Show("")
            Show("========== DICE ROLLER ==========")
            Show("1. Roll Dice")
            Show("0. Back")
            Show("")

            var choice = Convert.ToInt32(
                Input("Choose operation: ")
            )

            if choice == 0 {

                running = false
            }

            else if choice == 1 {

                var sides = Convert.ToInt32(
                    Input("Number of sides: ")
                )

                var result = Math.RandomInt(
                    1,
                    sides
                )

                Show("You rolled:")
                Show(result)

                if result == sides {
                    Show("MAX ROLL!")
                }
            }

            else {

                Show(
                    "Invalid choice. Please choose 1 or 0."
                )
            }
        }
    }


    // ========================================================
    // RUN APPLICATION
    // ========================================================

    Meta Run() {

        var running = true

        while running {

            Calculator.Menu()

            var choice = Convert.ToInt32(
                Input("Select an app: ")
            )

            if choice == 1 {

                Calculator.Basic()
            }

            else if choice == 2 {

                Calculator.Scientific()
            }

            else if choice == 3 {

                Calculator.Geometry()
            }

            else if choice == 4 {

                Calculator.Statistics()
            }

            else if choice == 5 {

                Calculator.NumberTheory()
            }

            else if choice == 6 {

                Calculator.Vector()
            }

            else if choice == 7 {

                Calculator.Matrix()
            }

            else if choice == 8 {

                Calculator.Damage()
            }

            else if choice == 9 {

                Calculator.Physics()
            }

            else if choice == 10 {

                Calculator.Dice()
            }

            else if choice == 11 {

                Show("")
                Show("Goodbye!")

                running = false
            }

            else {

                Show(
                    "Invalid choice. Please choose 1-11."
                )
            }
        }
    }
}


// ============================================================
// START APPLICATION
// ============================================================

Calculator.Create(
    "BlazeLang Math Application Suite"
)

Calculator.Run()