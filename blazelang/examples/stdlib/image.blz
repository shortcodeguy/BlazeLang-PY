Import Image from "image"

// ============================================================
// BlazeLang Image Module Test
// ============================================================

Show("========== IMAGE MODULE ==========")

// ============================================================
// CREATE
// ============================================================

Show("========== CREATE ==========")

var canvas = Image.Create(800, 600)

Show(canvas.width)
Show(canvas.height)

// ============================================================
// FILL
// ============================================================

Show("========== FILL ==========")

canvas.Fill("#202020")

// ============================================================
// DRAWING
// ============================================================

Show("========== DRAWING ==========")

canvas.DrawLine(0, 0, 799, 599)

canvas.DrawRect(
    50,
    50,
    200,
    100
)

canvas.DrawCircle(
    400,
    300,
    100
)

canvas.DrawText(
    100,
    200,
    "Hello Blaze!"
)

// ============================================================
// PIXELS
// ============================================================

Show("========== PIXELS ==========")

canvas.SetPixel(
    10,
    10,
    255,
    0,
    0
)

var pixel = canvas.GetPixel(10, 10)

Show(pixel)

// ============================================================
// SAVE ORIGINAL
// ============================================================

Show("========== SAVE ==========")

canvas.Save("image-original.png")

Show("Original image saved!")

// ============================================================
// RESIZE
// ============================================================

Show("========== RESIZE ==========")

canvas.Resize(400, 300)

Show(canvas.width)
Show(canvas.height)

// ============================================================
// ROTATE
// ============================================================

Show("========== ROTATE ==========")

canvas.Rotate(90)

Show(canvas.width)
Show(canvas.height)

// ============================================================
// FLIP
// ============================================================

Show("========== FLIP ==========")

canvas.FlipHorizontal()

canvas.FlipVertical()

// ============================================================
// FILTERS
// ============================================================

Show("========== FILTERS ==========")

canvas.Grayscale()

canvas.Invert()

canvas.Blur(3)

canvas.Sharpen()

// ============================================================
// SAVE PROCESSED
// ============================================================

Show("========== SAVE PROCESSED ==========")

canvas.Save("image-processed.png")

Show("Processed image saved!")

// ============================================================
// OPEN IMAGE
// ============================================================

Show("========== OPEN ==========")

var loaded = Image.Open("image-processed.png")

Show(loaded.width)
Show(loaded.height)

// ============================================================
// LOADED IMAGE PIXEL
// ============================================================

Show("========== LOADED PIXEL ==========")

var loadedPixel = loaded.GetPixel(10, 10)

Show(loadedPixel)

// ============================================================
// SECOND IMAGE
// ============================================================

Show("========== SECOND IMAGE ==========")

var second = Image.Create(256, 256)

second.Fill("#000000")

second.DrawRect(
    20,
    20,
    100,
    100
)

second.DrawCircle(
    128,
    128,
    60
)

second.DrawLine(
    0,
    0,
    255,
    255
)

second.DrawText(
    50,
    220,
    "BlazeLang"
)

second.SetPixel(
    128,
    128,
    255,
    0,
    0
)

Show(second.width)
Show(second.height)

second.Save("image-second.png")

// ============================================================
// SECOND IMAGE FILTER TEST
// ============================================================

Show("========== SECOND FILTER TEST ==========")

second.Grayscale()

second.Save("image-second-gray.png")

// ============================================================
// FINAL
// ============================================================

Show("========== IMAGE MODULE TEST COMPLETE ==========")