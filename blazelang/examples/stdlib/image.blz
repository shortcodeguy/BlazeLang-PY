Import Image from "image"

// ============================================================
// BlazeLang Image Module - Complete Showcase
// ============================================================

Show("========== BLAZELANG IMAGE MODULE ==========")

// ============================================================
// CREATE
// ============================================================

Show("========== CREATE ==========")

var canvas = Image.Create(800, 600)

Show(canvas.width)
Show(canvas.height)

// ============================================================
// BACKGROUND
// ============================================================

Show("========== BACKGROUND ==========")

canvas.Fill("#101820")

// ============================================================
// DRAWING
// ============================================================

Show("========== DRAWING ==========")

// Border
canvas.DrawRect(
    20,
    20,
    760,
    560
)

// Decorative lines
canvas.DrawLine(
    20,
    20,
    780,
    580
)

canvas.DrawLine(
    780,
    20,
    20,
    580
)

// Circles
canvas.DrawCircle(
    400,
    300,
    180
)

canvas.DrawCircle(
    400,
    300,
    120
)

// BlazeLang title
canvas.DrawText(
    250,
    285,
    "BLAZELANG"
)

canvas.DrawText(
    330,
    330,
    "IMAGE MODULE"
)

// ============================================================
// PIXELS
// ============================================================

Show("========== PIXELS ==========")

canvas.SetPixel(
    400,
    300,
    255,
    0,
    0
)

var pixel = canvas.GetPixel(
    400,
    300
)

Show(pixel)

// ============================================================
// SAVE ORIGINAL
// ============================================================

Show("========== SAVE ORIGINAL ==========")

canvas.Save(
    "blazelang-original.png"
)

Show("Original image saved!")

// ============================================================
// RESIZE
// ============================================================

Show("========== RESIZE ==========")

canvas.Resize(
    600,
    450
)

Show(canvas.width)
Show(canvas.height)

// ============================================================
// ROTATE
// ============================================================

Show("========== ROTATE ==========")

canvas.Rotate(90)

Show(canvas.width)
Show(canvas.height)

// ============================================================
// FLIP
// ============================================================

Show("========== FLIP ==========")

canvas.FlipHorizontal()
canvas.FlipVertical()

// ============================================================
// FILTERS
// ============================================================

Show("========== FILTERS ==========")

canvas.Grayscale()

canvas.Invert()

canvas.Blur(3)

canvas.Sharpen()

// ============================================================
// SAVE PROCESSED
// ============================================================

Show("========== SAVE PROCESSED ==========")

canvas.Save(
    "blazelang-processed.png"
)

Show("Processed image saved!")

// ============================================================
// OPEN IMAGE
// ============================================================

Show("========== OPEN IMAGE ==========")

var loaded = Image.Open(
    "blazelang-processed.png"
)

Show(loaded.width)
Show(loaded.height)

// ============================================================
// READ LOADED PIXEL
// ============================================================

Show("========== LOADED PIXEL ==========")

var loadedPixel = loaded.GetPixel(
    10,
    10
)

Show(loadedPixel)

// ============================================================
// SECOND IMAGE
// ============================================================

Show("========== SECOND IMAGE ==========")

var second = Image.Create(
    512,
    512
)

second.Fill("#202020")

second.DrawRect(
    50,
    50,
    412,
    412
)

second.DrawCircle(
    256,
    256,
    150
)

second.DrawLine(
    50,
    50,
    462,
    462
)

second.DrawLine(
    462,
    50,
    50,
    462
)

second.DrawText(
    170,
    250,
    "BlazeLang"
)

second.SetPixel(
    256,
    256,
    255,
    0,
    0
)

Show(second.width)
Show(second.height)

second.Save(
    "blazelang-second.png"
)

// ============================================================
// SECOND IMAGE FILTER
// ============================================================

Show("========== SECOND FILTER ==========")

second.Grayscale()

second.Save(
    "blazelang-second-gray.png"
)

// ============================================================
// FINAL
// ============================================================

Show("========== IMAGE MODULE COMPLETE ==========")
