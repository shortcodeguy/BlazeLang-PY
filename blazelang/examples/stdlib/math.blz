Show(Math.Factors(12))
Show(Math.PrimeFactors(60))
Show(Math.NextPrime(20))
Show(Math.IsEven(10))
Show(Math.IsOdd(7))

Show(Math.Sum(1, 2, 3, 4, 5))
Show(Math.Mean(10, 20, 30))
Show(Math.Median(1, 2, 3, 4))
Show(Math.Mode(1, 2, 2, 3, 3, 3))
Show(Math.Variance(1, 2, 3, 4, 5))
Show(Math.StdDev(1, 2, 3, 4, 5))
Show(Math.Range(10, 20, 5, 30))

Show(Math.Random())
Show(Math.RandomInt(1, 10))
Show(Math.RandomRange(1.5, 5.5))
Show(Math.RandomBool())
Show(Math.RandomChoice([1, 2, 3, 4, 5]))
Show(Math.RandomSign())

Show(Math.CircleArea(5))
Show(Math.CircleCircumference(5))
Show(Math.RectangleArea(10, 5))
Show(Math.TriangleArea(10, 5))
Show(Math.Distance2D(0, 0, 3, 4))
Show(Math.Distance3D(0, 0, 0, 1, 2, 2))

Show(Math.Abs(-42))
Show(Math.Sqrt(81))
Show(Math.Cbrt(27))
Show(Math.Pow(2, 8))
Show(Math.Sign(-10))
Show(Math.Trunc(12.98))

Show(Math.Sin(0))
Show(Math.Cos(0))
Show(Math.Tan(0))
Show(Math.Asin(1))
Show(Math.Acos(1))
Show(Math.Atan(1))
Show(Math.Atan2(1, 1))
Show(Math.Sinh(1))
Show(Math.Cosh(1))
Show(Math.Tanh(1))
Show(Math.Degrees(Math.PI))
Show(Math.Radians(180))

Show(Math.Log(Math.E))
Show(Math.Log(100, 10))
Show(Math.Log10(1000))
Show(Math.Log2(8))
Show(Math.Exp(1))

Show(Math.Floor(12.9))
Show(Math.Ceil(12.1))
Show(Math.Round(12.3456))
Show(Math.Round(12.3456, 2))

Show(Math.Min(10, 20, 5, 30))
Show(Math.Max(10, 20, 5, 30))
Show(Math.Clamp(120, 0, 100))
Show(Math.Hypot(3, 4))

Show(Math.Factorial(5))
Show(Math.Gcd(48, 18))
Show(Math.Lcm(4, 6))
Show(Math.IsPrime(97))
Show(Math.Mod(10, 3))

Show(Math.IsNaN(Math.NAN))
Show(Math.IsFinite(100))
Show(Math.IsFinite(Math.INFINITY))
Show(Math.IsInteger(10))
Show(Math.IsInteger(10.5))

// ============================================================
// COMBINED REAL-WORLD TESTS
// ============================================================

Show("========== COMBINED TESTS ==========")

// Game dev: ease a UI panel into view
var panelT = Math.Clamp01(0.6)
var panelEase = Math.EaseOutCubic(panelT)
Show(panelEase)

// Game dev: remap heading with wraparound
var heading = Math.Wrap(400, 0, 360)
Show(heading)

// Scripting: bit mixing
var mixed = Math.BitXor(Math.BitShiftLeft(12, 3), 10)
Show(mixed)

// Engineering: amplitude to decibels and back
var db = Math.ToDecibels(2)
var amplitude = Math.FromDecibels(db)
Show(db)
Show(amplitude)

// Cryptography-flavored: modular exponentiation
var cipher = Math.ModPow(5, 117, 19)
Show(cipher)

// Graphics: normalize and scale a direction vector
var direction = Math.VectorNormalize([3, 4])
var scaled = Math.VectorScale(direction, 10)
Show(scaled)

// Graphics: transform a point with a scaling matrix
var point = [
    [2],
    [3]
]
var scaleMatrix = Math.MatrixScale(Math.MatrixIdentity(2), 5)
var transformed = Math.MatrixMultiply(scaleMatrix, point)
Show(transformed)

// Original V2.1 combined checks, still valid
var radius = 5
var area = Math.CircleArea(radius)
Show(area)

var distance = Math.Distance2D(0, 0, 3, 4)
Show(distance)

var score = Math.Average(85, 90, 95)
Show(score)

var prime = Math.IsPrimeFast(97)
Show(prime)

var fib = Math.FastFibonacci(30)
Show(fib)

var vector = Math.VectorLength([3, 4])
Show(vector)

var combination = Math.Combinations(10, 2)
Show(combination)

var percentage = Math.Clamp01(1.25)
Show(percentage)

// ============================================================
// FINAL
// ============================================================

Show("========== MATH V3 DEVELOPER EDITION TEST COMPLETE ==========")
