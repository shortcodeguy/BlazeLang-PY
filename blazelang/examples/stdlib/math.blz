Show(Math.Cot(Math.PI / 4))
Show(Math.Asec(2))
Show(Math.Acsc(2))
Show(Math.Acot(1))
Show(Math.SinDeg(90))
Show(Math.CosDeg(0))
Show(Math.TanDeg(45))

Show(Math.Combinations(5, 2))
