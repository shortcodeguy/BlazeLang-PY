Show("BlazeLang JSON Module - Fixed V11")
Show("================================")

Import Json from "json"

Show("")
Show("========== BASIC PARSE ==========")

var basicJson = "{\"name\":\"Rohit\",\"age\":12,\"active\":true}"

var basic = Json.Parse(basicJson)

Show(basic)
Show(basic["name"])
Show(basic["age"])
Show(basic["active"])

Show("")
Show("========== STRINGIFY ==========")

var data = {
    name: "Rohit",
    age: 12,
    active: true,
    skills: [
        "Python",
        "C++",
        "BlazeLang"
    ]
}

var stringified = Json.Stringify(data)

Show(stringified)

Show("")
Show("========== STRINGIFY VALIDATION ==========")

Show(Json.Validate(stringified))

Show("")
Show("========== PARSE STRINGIFIED JSON ==========")

var parsed = Json.Parse(stringified)

Show(parsed)
Show(parsed["name"])
Show(parsed["age"])
Show(parsed["active"])
Show(parsed["skills"])
Show(parsed["skills"][0])
Show(parsed["skills"][2])

Show("")
Show("========== ROUND TRIP ==========")

var roundTrip = Json.Parse(Json.Stringify(data))

Show(roundTrip)
Show(Json.Stringify(roundTrip))

Show("")
Show("========== PRETTY JSON ==========")

var prettyJson = Json.Pretty(data)

Show(prettyJson)

Show("")
Show("========== PRETTY FROM STRING ==========")

var prettyFromString = Json.Pretty(stringified)

Show(prettyFromString)

Show("")
Show("========== VALIDATE ==========")

Show(Json.Validate("{\"name\":\"Rohit\"}"))
Show(Json.Validate("[1,2,3]"))
Show(Json.Validate("true"))
Show(Json.Validate("123"))
Show(Json.Validate("\"BlazeLang\""))
Show(Json.Validate("{invalid json}"))
Show(Json.Validate("{\"name\":\"Rohit\""))

Show("")
Show("========== JSON PRIMITIVES ==========")

Show(Json.Stringify(null))
Show(Json.Stringify(true))
Show(Json.Stringify(false))
Show(Json.Stringify(123))
Show(Json.Stringify(-123))
Show(Json.Stringify(12.5))
Show(Json.Stringify("Hello BlazeLang"))
Show(Json.Stringify([1, 2, 3]))

Show("")
Show("========== PARSE PRIMITIVES ==========")

Show(Json.Parse("null"))
Show(Json.Parse("true"))
Show(Json.Parse("false"))
Show(Json.Parse("123"))
Show(Json.Parse("-123"))
Show(Json.Parse("12.5"))
Show(Json.Parse("\"Hello BlazeLang\""))
Show(Json.Parse("[1,2,3]"))

Show("")
Show("========== NESTED OBJECT ==========")

var nested = {
    user: {
        profile: {
            name: "Rohit",
            age: 12,
            skills: [
                "Python",
                "C++",
                "BlazeLang"
            ]
        }
    }
}

var nestedJson = Json.Stringify(nested)

Show(nestedJson)

var nestedParsed = Json.Parse(nestedJson)

Show(nestedParsed)
Show(nestedParsed["user"]["profile"]["name"])
Show(nestedParsed["user"]["profile"]["age"])
Show(nestedParsed["user"]["profile"]["skills"][0])
Show(nestedParsed["user"]["profile"]["skills"][2])

Show("")
Show("========== ARRAY OF OBJECTS ==========")

var tasks = [
    {
        id: 1,
        title: "Learn BlazeLang",
        completed: true
    },
    {
        id: 2,
        title: "Build Task API",
        completed: false
    },
    {
        id: 3,
        title: "Test JSON V11",
        completed: false
    }
]

var tasksJson = Json.Stringify(tasks)

Show(tasksJson)
Show(Json.Validate(tasksJson))

var parsedTasks = Json.Parse(tasksJson)

Show(parsedTasks)
Show(parsedTasks[0]["title"])
Show(parsedTasks[1]["title"])
Show(parsedTasks[2]["completed"])

Show("")
Show("========== SPECIAL CHARACTERS ==========")

var special = {
    colon: "http://example.com:8080",
    newline: "line one\nline two",
    tab: "one\ttwo",
    unicode: "नमस्ते BlazeLang 🚀"
}

var specialJson = Json.Stringify(special)

Show(specialJson)
Show(Json.Validate(specialJson))

var specialParsed = Json.Parse(specialJson)

Show(specialParsed["colon"])
Show(specialParsed["newline"])
Show(specialParsed["tab"])
Show(specialParsed["unicode"])

Show("")
Show("========== UNICODE ==========")

var unicodeData = {
    message: "नमस्ते BlazeLang 🚀",
    language: "BlazeLang",
    country: "भारत"
}

var unicodeJson = Json.Stringify(unicodeData)

Show(unicodeJson)
Show(Json.Validate(unicodeJson))

var unicodeParsed = Json.Parse(unicodeJson)

Show(unicodeParsed["message"])
Show(unicodeParsed["country"])

Show("")
Show("========== FLOAT NORMALISATION ==========")

var integerFloat = 12.0
var normalFloat = 12.5

Show(Json.Stringify(integerFloat))
Show(Json.Stringify(normalFloat))

Show("")
Show("========== OBJECT WITH MIXED VALUES ==========")

var mixed = {
    nullValue: null,
    boolean: true,
    integer: 42,
    decimal: 3.14,
    text: "BlazeLang",
    array: [1, 2, 3],
    object: {
        language: "BlazeLang",
        version: 11
    }
}

var mixedJson = Json.Stringify(mixed)

Show(mixedJson)
Show(Json.Validate(mixedJson))

var mixedParsed = Json.Parse(mixedJson)

Show(mixedParsed)
Show(mixedParsed["text"])
Show(mixedParsed["array"])
Show(mixedParsed["object"]["language"])
Show(mixedParsed["object"]["version"])

Show("")
Show("========== COLON TEST ==========")

var colonText = "http://example.com:8080"

Show(colonText)

var colonJson = Json.Stringify({
    url: colonText,
    active: true
})

Show(colonJson)
Show(Json.Validate(colonJson))

var colonParsed = Json.Parse(colonJson)

Show(colonParsed["url"])
Show(colonParsed["url"] == colonText)

Show("")
Show("========== FINAL TESTS ==========")

Show(Json.Validate(Json.Stringify(data)))
Show(Json.Validate(Json.Stringify(nested)))
Show(Json.Validate(Json.Stringify(tasks)))
Show(Json.Validate(Json.Stringify(special)))
Show(Json.Validate(Json.Stringify(unicodeData)))
Show(Json.Validate(Json.Stringify(mixed)))

Show("")
Show("JSON V11 FIX TEST COMPLETE")
Show("================================")