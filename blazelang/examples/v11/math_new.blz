// BlazeLang Math Module V2.1 Test

Import Math from "math"

// ============================================================
// CONSTANTS
// ============================================================

Show("========== CONSTANTS ==========")

Show(Math.PI)
Show(Math.E)
Show(Math.TAU)
Show(Math.INFINITY)
Show(Math.NAN)

Show(Math.PHI)
Show(Math.SQRT2)
Show(Math.SQRT3)
Show(Math.LN2)
Show(Math.LN10)
Show(Math.LOG2E)
Show(Math.LOG10E)

// ============================================================
// BASIC ADVANCED MATH
// ============================================================

Show("========== ADVANCED BASIC MATH ==========")

Show(Math.Square(12))
Show(Math.Cube(5))
Show(Math.Reciprocal(4))
Show(Math.Frac(12.75))
Show(Math.Frac(-12.75))
Show(Math.Average(10, 20, 30))
Show(Math.Average(10, 20, 30, 40, 50))

// ============================================================
// ADDITIONAL TRIGONOMETRY
// ============================================================

Show("========== ADDITIONAL TRIGONOMETRY ==========")

Show(Math.Sec(0))
Show(Math.Csc(Math.PI / 2))
Show(Math.Cot(Math.PI / 4))

Show(Math.Asec(2))
Show(Math.Acsc(2))
Show(Math.Acot(1))

Show(Math.SinDeg(0))
Show(Math.SinDeg(30))
Show(Math.SinDeg(90))

Show(Math.CosDeg(0))
Show(Math.CosDeg(60))
Show(Math.CosDeg(180))

Show(Math.TanDeg(0))
Show(Math.TanDeg(45))

// ============================================================
// COMBINATORICS
// ============================================================

Show("========== COMBINATORICS ==========")

Show(Math.Combinations(5, 2))
Show(Math.Combinations(10, 3))

Show(Math.Permutations(5, 2))
Show(Math.Permutations(6, 3))

Show(Math.Binomial(5, 2))
Show(Math.Binomial(10, 5))

// ============================================================
// NUMBER THEORY
// ============================================================

Show("========== NUMBER THEORY ==========")

Show(Math.Fibonacci(0))
Show(Math.Fibonacci(1))
Show(Math.Fibonacci(10))
Show(Math.Fibonacci(15))

Show(Math.Factors(12))
Show(Math.Factors(36))

Show(Math.PrimeFactors(12))
Show(Math.PrimeFactors(60))
Show(Math.PrimeFactors(100))

Show(Math.NextPrime(20))
Show(Math.NextPrime(23))
Show(Math.NextPrime(50))

Show(Math.IsEven(10))
Show(Math.IsEven(7))

Show(Math.IsOdd(7))
Show(Math.IsOdd(10))

// ============================================================
// STATISTICS
// ============================================================

Show("========== STATISTICS ==========")

Show(Math.Sum(1, 2, 3, 4, 5))
Show(Math.Mean(10, 20, 30))
Show(Math.Median(1, 2, 3))
Show(Math.Median(1, 2, 3, 4))

Show(Math.Average(10, 20, 30))

Show(Math.Mode(1, 2, 2, 3, 3, 3))
Show(Math.Mode(5, 5, 2, 2, 3))

Show(Math.Variance(1, 2, 3, 4, 5))
Show(Math.StdDev(1, 2, 3, 4, 5))

Show(Math.Range(10, 20, 5, 30))
Show(Math.Range(1, 2, 3, 4, 5))

// ============================================================
// RANDOM
// ============================================================

Show("========== RANDOM ==========")

Show(Math.Random())
Show(Math.RandomInt(1, 10))
Show(Math.RandomRange(1.5, 5.5))

Show(Math.RandomBool())
Show(Math.RandomChoice([1, 2, 3, 4, 5]))
Show(Math.RandomSign())

// ============================================================
// GEOMETRY
// ============================================================

Show("========== GEOMETRY ==========")

Show(Math.CircleArea(5))
Show(Math.CircleCircumference(5))

Show(Math.RectangleArea(10, 5))
Show(Math.RectangleArea(7, 8))

Show(Math.TriangleArea(10, 5))
Show(Math.TriangleArea(20, 10))

Show(Math.Distance2D(0, 0, 3, 4))
Show(Math.Distance2D(1, 1, 4, 5))

Show(Math.Distance3D(0, 0, 0, 1, 2, 2))
Show(Math.Distance3D(0, 0, 0, 3, 4, 12))

// ============================================================
// VECTOR MATH
// ============================================================

Show("========== VECTOR MATH ==========")

Show(Math.VectorLength([3, 4]))
Show(Math.VectorLength([1, 2, 2]))

Show(Math.Dot([1, 2], [3, 4]))
Show(Math.Dot([1, 2, 3], [4, 5, 6]))

Show(Math.Cross([1, 0, 0], [0, 1, 0]))
Show(Math.Cross([0, 1, 0], [0, 0, 1]))

Show(Math.Cross([1, 2, 3], [4, 5, 6]))

// ============================================================
// ORIGINAL V2 FUNCTIONS REGRESSION
// ============================================================

Show("========== ORIGINAL MATH FUNCTIONS ==========")

Show(Math.Abs(-42))
Show(Math.Sqrt(81))
Show(Math.Cbrt(27))
Show(Math.Pow(2, 8))

Show(Math.Sign(-10))
Show(Math.Sign(0))
Show(Math.Sign(10))

Show(Math.Trunc(12.98))

Show(Math.Sin(0))
Show(Math.Cos(0))
Show(Math.Tan(0))

Show(Math.Asin(1))
Show(Math.Acos(1))
Show(Math.Atan(1))
Show(Math.Atan2(1, 1))

Show(Math.Sinh(1))
Show(Math.Cosh(1))
Show(Math.Tanh(1))

Show(Math.Degrees(Math.PI))
Show(Math.Radians(180))

Show(Math.Log(Math.E))
Show(Math.Log(100, 10))
Show(Math.Log10(1000))
Show(Math.Log2(8))
Show(Math.Exp(1))

Show(Math.Floor(12.9))
Show(Math.Ceil(12.1))
Show(Math.Round(12.3456))
Show(Math.Round(12.3456, 2))

Show(Math.Min(10, 20, 5, 30))
Show(Math.Max(10, 20, 5, 30))

Show(Math.Clamp(120, 0, 100))
Show(Math.Clamp(50, 0, 100))
Show(Math.Clamp(-10, 0, 100))

Show(Math.Lerp(0, 100, 0.5))
Show(Math.Hypot(3, 4))

Show(Math.Factorial(5))
Show(Math.Gcd(48, 18))
Show(Math.Lcm(4, 6))
Show(Math.IsPrime(97))
Show(Math.Mod(10, 3))

Show(Math.IsNaN(Math.NAN))
Show(Math.IsFinite(100))
Show(Math.IsFinite(Math.INFINITY))
Show(Math.IsInteger(10))
Show(Math.IsInteger(10.5))

// ============================================================
// COMBINED REAL-WORLD TESTS
// ============================================================

Show("========== COMBINED TESTS ==========")

// Circle calculation
var radius = 5
var area = Math.CircleArea(radius)
Show(area)

// Distance calculation
var distance = Math.Distance2D(0, 0, 3, 4)
Show(distance)

// Average score
var score = Math.Average(85, 90, 95)
Show(score)

// Prime number
var prime = Math.IsPrime(97)
Show(prime)

// Fibonacci
var fib = Math.Fibonacci(10)
Show(fib)

// Vector
var vector = Math.VectorLength([3, 4])
Show(vector)

// Combination
var combination = Math.Combinations(10, 2)
Show(combination)

// Clamp percentage
var percentage = Math.Clamp(125, 0, 100)
Show(percentage)

// ============================================================
// FINAL
// ============================================================

Show("========== MATH V2.1 TEST COMPLETE ==========")
