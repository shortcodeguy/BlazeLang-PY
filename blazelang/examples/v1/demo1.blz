// ======================================
// BlazeLang Survival Game
// ======================================

Show("===================================")
Show("     Blaze Survival Simulator")
Show("===================================")
Show("")

Class Player {

    Constructor(name) {
        this.name = name
        this.health = 100
        this.food = 50
        this.gold = 0
    }

    Meta eat(amount) {
        this.food = this.food + amount

        if this.food > 100 {
            this.food = 100
        }

        Show("{this.name} ate food.")
    }

    Meta damage(amount) {
        this.health = this.health - amount

        if this.health < 0 {
            this.health = 0
        }

        Show("{this.name} lost {amount} health.")
    }

    Meta reward(amount) {
        this.gold = this.gold + amount
        Show("{this.name} found {amount} gold.")
    }

    Function alive() {
        return this.health > 0
    }

    Meta stats() {
        Show("----------------------------")
        Show("Player : {this.name}")
        Show("Health : {this.health}")
        Show("Food   : {this.food}")
        Show("Gold   : {this.gold}")
        Show("----------------------------")
    }
}

Function average(values) {

    var total = 0

    for value in values {
        total = total + value
    }

    return total / len(values)
}

Function maxValue(values) {

    var highest = values[0]

    for value in values {
        if value > highest {
            highest = value
        }
    }

    return highest
}

var player = Player("Explorer")

player.stats()

Show("")
Show("=== 5 Days of Survival ===")

var dailyFood = []

for day in range(1,6) {

    Show("")
    Show("Day {day}")

    var hunt = Random(5,20)
    var damage = Random(0,15)
    var treasure = Random(0,100)

    player.eat(hunt)
    player.damage(damage)

    if treasure > 70 {
        player.reward(treasure)
    }

    dailyFood = dailyFood + [hunt]

    if not player.alive() {
        Show("Game Over!")
        break
    }
}

Show("")
Show("=== Statistics ===")

Show("Average food found: {average(dailyFood)}")
Show("Best food haul: {maxValue(dailyFood)}")

Show("")

try {

    if player.gold < 50 {
        throw "Player is still poor!"
    }

    Show("Enough gold collected.")

}
catch(error) {

    Show("Warning: {error}")

}
finally {

    Show("Adventure finished.")

}

Show("")
player.stats()

Show("")
Show("Simulation Complete.")